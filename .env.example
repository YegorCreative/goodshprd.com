# Server only. Never commit a populated .env file.
# Managed PostgreSQL pooled connection; use provider TLS configuration (verify-full).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
# Canonical origin, no path or trailing slash. HTTPS required outside localhost development.
APP_ORIGIN=https://goodshprd.com
# Generate a random value with at least 32 bytes of entropy.
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Your numeric GitHub user ID, not your login/display name.
FINANCE_OWNER_GITHUB_ID=REPLACE_WITH_NUMERIC_GITHUB_ID
# Dedicated Finance OAuth app; callback APP_ORIGIN/api/auth/callback.
GITHUB_OAUTH_CLIENT_ID=REPLACE_WITH_CLIENT_ID
GITHUB_OAUTH_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
STRIPE_SECRET_KEY=REPLACE_WITH_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SIGNING_SECRET
